# Copy to .env.production on the server (chmod 600). Never commit the real file.
SITE_DOMAIN=aristia.net
# id -u aristia / id -g aristia
APP_UID=1010
APP_GID=1009

ENVIRONMENT=prod
DEBUG=False
DJANGO_SECRET_KEY=change-me
DJANGO_LOGLEVEL=info
DJANGO_ALLOWED_HOSTS=.aristia.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://aristia.net,https://www.aristia.net

DATABASE_USERNAME=aristia
DATABASE_PASSWORD=change-me
DATABASE_NAME=aristia
DATABASE_HOST=host.docker.internal
DATABASE_PORT=3306
